# Copy this file to .env.local and fill in the values described in SETUP.md

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser. Used by Edge Functions in Phase 5.
SUPABASE_SERVICE_ROLE_KEY=

# Strava (Phase 5) — leave blank until you reach that phase
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
NEXT_PUBLIC_STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
