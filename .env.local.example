# Copy this file to .env.local and fill in the values described in SETUP.md

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Strava — see SETUP.md for how to get these
NEXT_PUBLIC_STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
NEXT_PUBLIC_STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# Any random string you choose — must also be set as an Edge Function secret
# with the exact same value (supabase secrets set). This is what encrypts
# your Strava tokens at rest; losing/changing it makes existing tokens
# undecryptable, so generate it once and keep it somewhere safe.
STRAVA_TOKEN_ENCRYPTION_KEY=
